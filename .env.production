# =============================================================================
# VOMP Admin — PRODUCTION (dev environment on Contabo)
# =============================================================================
# Loaded automatically by `next build` / `next start` (NODE_ENV=production).
# This file is committed and MUST NOT contain secrets. Put secrets on the server
# in `.env.production.local` (git-ignored) — see the block printed at deploy time
# or the README. Local development continues to use `.env.local` (localhost).
# =============================================================================

# --- Domains ----------------------------------------------------------------
# The admin browser UI calls the API at the dedicated API sub-domain.
NEXT_PUBLIC_API_URL=https://dev.api.venueonmyplate.com

# The admin UI origin — used for credentialed CORS + CSRF validation on the API.
ADMIN_ORIGIN=https://dev-admin.venueonmyplate.com

# Host that serves the public API landing page at "/" (the admin sub-domain
# keeps redirecting "/" → /dashboard). Defaults to the NEXT_PUBLIC_API_URL host,
# so it is already dev.api.venueonmyplate.com — uncomment only to override.
# API_LANDING_HOST=dev.api.venueonmyplate.com

# Public website base — used for on-demand cache revalidation after publishing.
MAIN_SITE_URL=https://dev.venueonmyplate.com

# --- Session cookie (shared across *.venueonmyplate.com sub-domains) --------
# Scope the HttpOnly session cookie to the parent domain so BOTH the admin UI
# (dev-admin) and the API (dev.api) receive it.
SESSION_COOKIE_DOMAIN=.venueonmyplate.com
SESSION_COOKIE_SAMESITE=lax

# --- Non-secret tunables ----------------------------------------------------
JWT_EXPIRES_IN=7d

# =============================================================================
# SECRETS — DO NOT PUT HERE. Create `.env.production.local` on the server with:
#   ADMIN_EMAIL=admin@venueonmyplate.in
#   ADMIN_PASSWORD=<strong-password>
#   ADMIN_SECRET=<random>
#   JWT_SECRET=<random-64+ chars>
#   REVALIDATE_SECRET=<must match the public website>
# =============================================================================
